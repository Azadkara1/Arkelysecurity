{
  "name": "arkelys-security",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check:xx && pnpm run check:tirets && astro check && astro build",
    "build:preprod": "pnpm run check:tirets && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:xx": "node scripts/check-xx.mjs",
    "assets:logo": "node scripts/build-logo-assets.mjs",
    "test": "node --test --experimental-strip-types \"src/lib/**/*.test.ts\"",
    "check:tirets": "node scripts/check-tirets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
