---
/**
 * Grille « semaine type » du formulaire de contact.
 *
 * Grille 7 jours sur 24 heures : cellules compactes, mêmes couleurs que le
 * reste du site. Le visiteur clique ou glisse pour
 * colorer les heures souhaitées. Rien d'autre : pas de nombre de postes, pas
 * de calcul, pas de résultat.
 *
 * Les deux champs cachés partent avec le formulaire :
 *   `semaine_type`      un résumé lisible, pour que le courriel se lise sans
 *                       outil, par exemple « Lun de 20 h à 8 h ; Mar de 8 h
 *                       à 20 h » ;
 *   `semaine_type_json` les mêmes données en brut.
 *
 * Le comportement est dans src/lib/semaine-type.ts.
 */
const JOURS = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
const JOURS_COURTS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
const heures = Array.from({ length: 24 }, (_, h) => h);
---

<div data-semaine-type-bloc>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="micro text-accent-texte">Semaine type</p>
      <p class="text-texte-doux mesure mt-3 text-sm">
        Indiquez les heures que vous souhaitez couvrir. Cliquez ou glissez sur
        la grille, ou déplacez-vous aux flèches du clavier et basculez une
        case avec la barre d’espace.
      </p>
    </div>
    <button
      type="button"
      data-semaine-effacer
      class="micro border-filet text-texte-doux hover:border-accent-bord hover:text-texte border px-4 py-2.5"
    >
      Tout effacer
    </button>
  </div>

  <div class="mt-8 overflow-x-auto pb-2">
    <div data-semaine-type class="min-w-[640px] select-none" style="touch-action: none;">
      <!-- Règle des heures -->
      <div class="flex items-end gap-px pl-14">
        {
          heures.map((h) => (
            <span class="micro text-texte-doux w-full text-center" aria-hidden="true">
              {h % 3 === 0 ? h : ''}
            </span>
          ))
        }
      </div>

      {
        JOURS.map((jour, indexJour) => (
          <div class="mt-px flex items-center gap-px">
            <span class="micro text-texte-doux w-14 shrink-0 pr-2 text-right">
              {JOURS_COURTS[indexJour]}
            </span>
            {heures.map((heure) => (
              <button
                type="button"
                data-creneau={indexJour * 24 + heure}
                aria-pressed="false"
                aria-label={`${jour}, ${heure} heure`}
                class="bg-surface-2 border-filet hover:border-accent-bord aria-pressed:bg-accent/35 aria-pressed:border-accent-bord h-6 w-full border transition-colors duration-200"
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <p class="micro text-accent-texte mt-5" aria-live="polite" data-semaine-apercu>
    Aucune plage indiquée.
  </p>

  <!-- Ce qui part réellement avec le formulaire. -->
  <input type="hidden" name="semaine_type" data-semaine-lisible value="Aucune plage indiquée." />
  <input type="hidden" name="semaine_type_json" data-semaine-json value="[]" />
</div>
