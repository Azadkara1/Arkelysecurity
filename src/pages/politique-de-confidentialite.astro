---
/**
 * /politique-de-confidentialite.
 *
 * TODO CLIENT : faire relire par le conseil juridique. Les durées de
 * conservation sont des durées d'usage et doivent être confirmées par le
 * responsable de traitement.
 */
import Base from '@layouts/Base.astro';
import { entreprise } from '@data/entreprise';

const traitements = [
  {
    finalite: 'Répondre à une demande de contact ou de devis',
    donnees:
      'Nom, société, téléphone, courriel, description du site, type de missions souhaité et semaine type indiquée sur la grille',
    base: 'Mesures précontractuelles prises à la demande de la personne',
    duree: '3 ans à compter du dernier échange',
  },
];

const droits = [
  'Droit d’accès à vos données',
  'Droit de rectification',
  'Droit à l’effacement',
  'Droit à la limitation du traitement',
  'Droit d’opposition',
  'Droit à la portabilité',
];
---

<Base
  titre="Politique de confidentialité, ARKELYS SECURITY"
  description="Traitement des données transmises par le formulaire du site : finalités, destinataires, durées de conservation et exercice de vos droits."
  filAriane={[
    { libelle: 'Politique de confidentialité', href: '/politique-de-confidentialite' },
  ]}
>
  <section class="bg-surface text-texte">
    <div class="contenu section-y">
      <p class="micro text-accent-texte">Informations légales</p>
      <h1 class="font-display mt-8 text-4xl leading-[0.95] lg:text-6xl">
        Politique de confidentialité
      </h1>
      <p class="mesure text-texte-doux mt-10 text-lg">
        Ce site ne collecte que ce que vous lui donnez volontairement, par son
        formulaire de contact. Il ne dépose aucun cookie de mesure d’audience,
        de publicité ou de réseau social, et ne charge aucune ressource depuis
        un domaine tiers.
      </p>

      <h2 class="font-display mt-20 text-2xl lg:text-3xl">Responsable de traitement</h2>
      <p class="mesure text-texte-doux mt-6">
        {entreprise.nom}, {entreprise.adresse.rue}, {entreprise.adresse.cp}&nbsp;{
          entreprise.adresse.ville
        }. Contact&nbsp;:{' '}
        <a
          href={`mailto:${entreprise.contact.email}`}
          class="text-texte underline underline-offset-4"
        >
          {entreprise.contact.email}
        </a>.
      </p>

      <h2 class="font-display mt-20 text-2xl lg:text-3xl">Ce que nous traitons, et pourquoi</h2>
      <div class="mt-10 space-y-px">
        {
          traitements.map((t) => (
            <article class="border-filet border p-8">
              <h3 class="font-display text-xl">{t.finalite}</h3>
              <dl class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
                <div>
                  <dt class="micro text-texte-doux">Données</dt>
                  <dd class="mt-2 text-sm">{t.donnees}</dd>
                </div>
                <div>
                  <dt class="micro text-texte-doux">Base légale</dt>
                  <dd class="mt-2 text-sm">{t.base}</dd>
                </div>
                <div>
                  <dt class="micro text-texte-doux">Conservation</dt>
                  <dd class="mt-2 text-sm">{t.duree}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>

      <h2 class="font-display mt-20 text-2xl lg:text-3xl">Qui y a accès</h2>
      <p class="mesure text-texte-doux mt-6">
        Les données du formulaire sont transmises à l’équipe commerciale
        d’{entreprise.nom} et à elle seule. Elles ne sont ni vendues, ni
        cédées, ni utilisées à des fins de prospection pour un tiers.
      </p>
      <p class="mesure text-texte-doux mt-6">
        Techniquement, les envois de formulaire transitent par le service de
        formulaires de notre hébergeur, {entreprise.hebergeur.nom}, qui agit en
        qualité de sous-traitant.
      </p>

      <h2 class="font-display mt-20 text-2xl lg:text-3xl">Vos droits</h2>
      <ul class="mt-8 grid grid-cols-1 gap-px sm:grid-cols-2 lg:grid-cols-3">
        {
          droits.map((droit) => (
            <li class="border-filet text-texte-doux border p-5 text-sm">{droit}</li>
          ))
        }
      </ul>
      <p class="mesure text-texte-doux mt-8">
        Pour les exercer, écrivez à{' '}
        <a
          href={`mailto:${entreprise.contact.email}`}
          class="text-texte underline underline-offset-4"
        >
          {entreprise.contact.email}
        </a>. Vous pouvez également introduire une réclamation auprès de la
        CNIL.
      </p>

      <h2 class="font-display mt-20 text-2xl lg:text-3xl">Cookies</h2>
      <p class="mesure text-texte-doux mt-6">
        Aucun cookie n’est déposé par ce site. Il n’y a donc pas de bandeau de
        consentement à afficher, et rien à paramétrer de votre côté.
      </p>
      <p class="mesure text-texte-doux mt-6">
        Le choix de thème, sombre ou clair, est conservé dans le stockage
        local de votre navigateur. Il ne nous est jamais transmis et ne permet
        pas de vous identifier.
      </p>

      <p class="text-texte-doux mt-16 text-sm">
        Page à faire relire par le conseil juridique avant mise en ligne. Les
        durées de conservation doivent être confirmées par le responsable de
        traitement.
      </p>
    </div>
  </section>
</Base>
